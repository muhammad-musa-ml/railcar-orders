{
  "name": "railcar-orders",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless railcar order intake and car allocation on AWS (API Gateway, Lambda, DynamoDB, SQS), with synthetic data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "ddb:start": "docker run -d --rm --name railcar-orders-ddb -p 8000:8000 amazon/dynamodb-local:3.3.1 -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "ddb:stop": "docker stop railcar-orders-ddb",
    "synth": "cdk synth --quiet",
    "config:report": "tsx scripts/config-report.ts",
    "local:race": "tsx scripts/local/race.ts",
    "cdk:aws": "tsx scripts/live/cdk.ts",
    "bootstrap": "tsx scripts/live/cdk.ts bootstrap",
    "deploy": "tsx scripts/live/cdk.ts deploy --require-approval never",
    "destroy": "tsx scripts/live/cdk.ts destroy --force",
    "live:preflight": "tsx scripts/live/preflight.ts",
    "live:load": "tsx scripts/live/load-test.ts",
    "live:cold": "tsx scripts/live/cold-start.ts",
    "live:race": "tsx scripts/live/concurrency-check.ts",
    "live:poison": "tsx scripts/live/poison-check.ts",
    "live:summary": "tsx scripts/live/summarize.ts",
    "live:verify-teardown": "tsx scripts/live/verify-teardown.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.1154.0",
    "@aws-sdk/client-cloudformation": "^3.1154.0",
    "@aws-sdk/client-cloudwatch": "^3.1154.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1154.0",
    "@aws-sdk/client-lambda": "^3.1154.0",
    "@aws-sdk/client-sns": "^3.1154.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1146.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
